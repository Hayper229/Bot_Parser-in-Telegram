api =  'BOT_TOKEN'
bot = telebot.TeleBot(api)

@bot.message_handler(commands=['start', 'старт', 'me', 'sticker', 'donate', 'link'])
def start(message):
    if message.text == '/start':
       bot.reply_to(message, f'Hi User {message.chat.id}!!\nВведи канал/чат пример @durov\nдля просмотра справки введи /help или /помощь', parse_mode='Markdown')
    elif message.text == '/me':
       me(message)
    elif message.text == '/link':
         link(message)
    elif message.text == '/donate':
         donate(message)
    elif message.text == '/sticker':
         bot.send_sticker(message.chat.id, 'CAACAgIAAxkBAAEBUk1oQYhq8vOhu6AygPkr4NACzKoNMQACpRAAAjpR2ErTa1u1cj92ozYE')


def me(message):
    bot.reply_to(message, f'INFO\nID: {message.from_user.id}\nFirst_Name: {message.from_user.first_name}\nUser_Name: {message.from_user.username}', parse_mode=None)

@bot.message_handler(commands=['usage'])
